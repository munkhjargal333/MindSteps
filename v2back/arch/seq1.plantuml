@startuml
autonumber

actor User
participant JournalEntry
participant SeedInsight
participant Queue
participant Worker
participant Analysis
participant ValueGraph

User -> JournalEntry : writeEntry()
activate JournalEntry

JournalEntry -> SeedInsight : generateInsight()
activate SeedInsight
SeedInsight --> User : insight
deactivate SeedInsight

JournalEntry -> Queue : enqueue(entry)
deactivate JournalEntry
activate Queue


Worker -> Queue : dequeue()
activate Worker

Queue --> Worker : entry
deactivate Queue

Worker -> Analysis : analyzeEntries()
activate Analysis
Analysis --> Worker : analysisResult
deactivate Analysis

Worker -> ValueGraph : updateGraph(analysisResult)
activate ValueGraph
ValueGraph --> Worker : updated
deactivate ValueGraph

deactivate Worker

@enduml