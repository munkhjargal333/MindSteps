{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "providers": ["go"],
      "phases": {
        "install": {
          "cmds": ["go mod download"]
        },
        "build": {
          "cmds": ["go build -o ./backend/bin/api ./cmd/api/main.go"]
        }
      }
    },
    "context": "backend"
  },
  "deploy": {
    "startCommand": "./backend/bin/api"
  }
}
